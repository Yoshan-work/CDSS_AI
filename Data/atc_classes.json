  "allergy_cross_reactivity_matrix": {
    "penicillin": {
      "label": "Penicillin / Beta-Lactam Allergy",
      "direct_allergy_groups": ["penicillin"],
      "cross_reactive_groups": {
        "cephalosporin": {
          "risk_if_severe": "HIGH",
          "risk_if_mild": "MODERATE",
          "message": "Penicillin to Cephalosporin cross-reactivity (~1-2% overall; higher with 1st-gen cephalexin sharing R1 side chain). Avoid cephalexin if index penicillin reaction was severe/anaphylaxis; use 3rd-gen ceftriaxone with caution if mild rash."
        },
        "carbapenem": {
          "risk_if_severe": "MODERATE",
          "risk_if_mild": "LOW",
          "message": "Low cross-reactivity (<1%) between penicillins and carbapenems, but use caution in patients with history of severe IgE-mediated penicillin anaphylaxis."
        }
      }
    },
    "cephalosporin": {
      "label": "Cephalosporin Allergy",
      "direct_allergy_groups": ["cephalosporin"],
      "cross_reactive_groups": {
        "penicillin": {
          "risk_if_severe": "HIGH",
          "risk_if_mild": "MODERATE",
          "message": "Potential beta-lactam R1 side-chain cross-reactivity between cephalosporins and penicillins (especially cephalexin and amoxicillin/ampicillin)."
        }
      }
    },
    "sulfonamide": {
      "label": "Sulfonamide (Sulfa) Allergy",
      "direct_allergy_groups": ["sulfonamide_antibiotic"],
      "cross_reactive_groups": {
        "sulfonamide_non_antibiotic": {
          "risk_if_severe": "MODERATE",
          "risk_if_mild": "LOW",
          "message": "Non-arylamine sulfonamides (furosemide, hydrochlorothiazide, celecoxib, gliclazide) have minimal immunologic cross-reactivity with sulfonamide antibiotics, but avoid if history of severe Stevens-Johnson syndrome/TEN."
        }
      }
    },
    "nsaid": {
      "label": "NSAID / Aspirin Hypersensitivity",
      "direct_allergy_groups": ["nsaid", "salicylate"],
      "cross_reactive_groups": {
        "cox2_nsaid": {
          "risk_if_severe": "HIGH",
          "risk_if_mild": "MODERATE",
          "message": "Patients with aspirin/NSAID-exacerbated respiratory disease (AERD), bronchospasm, or angioedema show cross-reactivity across COX-1 inhibiting NSAIDs and potential reaction to COX-2 inhibitors (celecoxib)."
        }
      }
    },
    "aspirin": {
      "label": "Aspirin / Salicylate Allergy",
      "direct_allergy_groups": ["salicylate", "nsaid"],
      "cross_reactive_groups": {
        "cox2_nsaid": {
          "risk_if_severe": "HIGH",
          "risk_if_mild": "MODERATE",
          "message": "Aspirin-induced asthma/angioedema cross-reacts across all COX-1 NSAIDs (ibuprofen, diclofenac, naproxen, mefenamic acid) via leukotriene overproduction."
        }
      }
    },
