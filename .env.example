# ==============================================================================
# CDSS (Clinical Decision Support System) - Environment Template
# Copy this file to .env and fill in your values.
# ==============================================================================

# Local Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# openFDA Drug Label API (Optional free key to raise rate limits: https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=

# FastAPI Server Settings
CDSS_HOST=127.0.0.1
CDSS_PORT=8000

# Logging Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
